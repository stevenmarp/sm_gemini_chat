<?xml version="1.0" encoding="utf-8"?>
<odoo>
      <record id="res_config_settings_view_form_sm_gemini_chat" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.sm.gemini.chat</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                  <xpath expr="//form" position="inside">
                        <div class="app_settings_block" data-key="sm_gemini_chat" string="Gemini AI Chat">
                              <h2>Gemini AI Chat</h2>
                              <div class="text-muted mb-4">
                                    Built-in Google Gemini API settings for the Odoo chat assistant.
                              </div>

                              <div class="row mt16 o_settings_container">
                                    <div class="col-12 col-lg-6 o_setting_box">
                                          <div class="o_setting_left_pane"/>
                                          <div class="o_setting_right_pane">
                                                <div class="o_form_label">Gemini API Key</div>
                                                <div class="text-muted">
                                                      Stored in Odoo system parameters and used by Gemini Chat.
                                                </div>
                                                <div class="mt16">
                                                      <field name="sm_gemini_chat_gemini_api_key"
                                                            password="True"
                                                            placeholder="AIzaSy..."/>
                                                </div>
                                          </div>
                                    </div>

                                    <div class="col-12 col-lg-6 o_setting_box">
                                          <div class="o_setting_left_pane"/>
                                          <div class="o_setting_right_pane">
                                                <div class="o_form_label">Connection Test</div>
                                                <div class="text-muted">
                                                      Verify API key, model, endpoint, and quota.
                                                </div>
                                                <div class="mt16">
                                                      <button name="action_sm_gemini_chat_test_gemini_connection"
                                                            type="object"
                                                            string="Test Gemini Connection"
                                                            class="btn btn-primary"/>
                                                </div>
                                          </div>
                                    </div>
                              </div>

                              <div class="row mt16 o_settings_container">
                                    <div class="col-12 col-lg-6 o_setting_box">
                                          <div class="o_setting_left_pane"/>
                                          <div class="o_setting_right_pane">
                                                <div class="o_form_label">Model</div>
                                                <div class="text-muted">
                                                      Default Gemini model used by the chat assistant.
                                                </div>
                                                <div class="mt16">
                                                      <field name="sm_gemini_chat_gemini_model"/>
                                                </div>
                                                <div class="mt16" invisible="sm_gemini_chat_gemini_model != 'custom'">
                                                      <field name="sm_gemini_chat_gemini_custom_model"
                                                            placeholder="gemini-2.5-flash-lite"/>
                                                </div>
                                          </div>
                                    </div>

                                    <div class="col-12 col-lg-6 o_setting_box">
                                          <div class="o_setting_left_pane"/>
                                          <div class="o_setting_right_pane">
                                                <div class="o_form_label">API Endpoint</div>
                                                <div class="text-muted">
                                                      Google Generative Language API base URL.
                                                </div>
                                                <div class="mt16">
                                                      <field name="sm_gemini_chat_gemini_api_base_url"/>
                                                </div>
                                                <div class="mt16">
                                                      <label for="sm_gemini_chat_request_timeout"
                                                            class="me-2">Timeout</label>
                                                      <field name="sm_gemini_chat_request_timeout"/>
                                                      <span class="text-muted ms-2">seconds</span>
                                                </div>
                                          </div>
                                    </div>
                              </div>

                              <div class="row mt16 o_settings_container">
                                    <div class="col-12 col-lg-6 o_setting_box">
                                          <div class="o_setting_left_pane"/>
                                          <div class="o_setting_right_pane">
                                                <div class="o_form_label">Usage Tracking</div>
                                                <div class="text-muted">
                                                      Track Gemini token usage and stop requests after a monthly limit.
                                                </div>
                                                <div class="row mt16 align-items-center">
                                                      <label for="sm_gemini_chat_tokens_used"
                                                            class="col-12 col-lg-4">Tokens Used</label>
                                                      <div class="col-12 col-lg-4">
                                                            <field name="sm_gemini_chat_tokens_used" readonly="1"/>
                                                      </div>
                                                </div>
                                                <div class="row mt-2 align-items-center">
                                                      <label for="sm_gemini_chat_monthly_token_limit"
                                                            class="col-12 col-lg-4">Monthly Limit</label>
                                                      <div class="col-12 col-lg-4">
                                                            <field name="sm_gemini_chat_monthly_token_limit"/>
                                                      </div>
                                                      <div class="col-12 col-lg-4 text-muted">
                                                            0 = unlimited
                                                      </div>
                                                </div>
                                                <div class="mt16">
                                                      <button name="action_sm_gemini_chat_reset_token_counter"
                                                            type="object"
                                                            string="Reset Counter"
                                                            class="btn btn-outline-secondary btn-sm"/>
                                                </div>
                                          </div>
                                    </div>
                              </div>
                        </div>
                  </xpath>
            </field>
      </record>
</odoo>
